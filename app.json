{
  "expo": {
    "name": "Shahriyar — شهریار",
    "slug": "buildiran",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/shahriyar-app-icon.png",
    "scheme": "buildiran",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/shahriyar-app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0D12",
        "foregroundImage": "./assets/images/shahriyar-adaptive-icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/shahriyar-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.buildiran"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/shahriyar-favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D12",
          "image": "./assets/images/shahriyar-logo-fa.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Vazirmatn-Black.ttf",
            "./assets/fonts/Vazirmatn-Bold.ttf",
            "./assets/fonts/Vazirmatn-ExtraBold.ttf",
            "./assets/fonts/Vazirmatn-ExtraLight.ttf",
            "./assets/fonts/Vazirmatn-Light.ttf",
            "./assets/fonts/Vazirmatn-Medium.ttf",
            "./assets/fonts/Vazirmatn-Regular.ttf",
            "./assets/fonts/Vazirmatn-SemiBold.ttf",
            "./assets/fonts/Vazirmatn-Thin.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4be70f1f-aec4-4dd1-b56d-a34ebcf566b3"
      }
    },
    "owner": "hamidrexa"
  }
}
